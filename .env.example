# ============================================================
# Stripe PayPlatform - Environment Variables Template
# All secret values must be kept confidential and NEVER committed.
# ============================================================

# Stripe Public Key (Safe for browser / client-side Stripe.js)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Stripe Secret Key (SERVER-ONLY - Never expose to client)
# Test mode begins with: sk_test_...
# Live mode begins with: sk_live_...
STRIPE_SECRET_KEY=""

# Stripe Webhook Signing Secret (SERVER-ONLY)
# Obtained from Stripe Dashboard Webhooks or 'stripe listen'
# Begins with: whsec_...
STRIPE_WEBHOOK_SECRET=""

# PostgreSQL Database Connection String (SERVER-ONLY)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=""

# Application Host URL (SERVER-ONLY, e.g. https://your-domain.vercel.app)
APP_URL="http://localhost:3000"

# Optional Branding and UI metadata
NEXT_PUBLIC_APP_NAME="Stripe PayPlatform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Studio runtime (optional)
GEMINI_API_KEY=""
